{
  "info": {
    "name": "Card Product Management API",
    "description": "Import this collection, start the backend on port 8080, then run the requests in order. Set productId and version after creating a product.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "productId", "value": "1" },
    { "key": "version", "value": "0" },
    { "key": "idempotencyKey", "value": "postman-create-001" }
  ],
  "item": [
    {
      "name": "Card products",
      "item": [
        {
          "name": "List products - page 1",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/card-products?page=0" }
        },
        {
          "name": "Get product by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/card-products/{{productId}}" }
        },
        {
          "name": "Create credit card product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Postman Rewards Card\",\n  \"cardType\": \"CREDIT\",\n  \"quantity\": 25,\n  \"annualFee\": 100.00,\n  \"annualInterestRate\": 15.00\n}"
            },
            "url": "{{baseUrl}}/api/v1/card-products"
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Postman Rewards Card Updated\",\n  \"cardType\": \"CREDIT\",\n  \"quantity\": 30,\n  \"annualFee\": 120.00,\n  \"annualInterestRate\": 15.50,\n  \"version\": {{version}}\n}"
            },
            "url": "{{baseUrl}}/api/v1/card-products/{{productId}}"
          }
        },
        {
          "name": "Delete product",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/card-products/{{productId}}" }
        }
      ]
    },
    {
      "name": "Exchange rates",
      "item": [
        {
          "name": "List available currencies",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/exchange-rates/currencies" }
        },
        {
          "name": "MYR to USD",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/exchange-rates?to=USD" }
        },
        {
          "name": "MYR to SGD",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/exchange-rates?to=SGD" }
        },
        {
          "name": "MYR to MYR",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/exchange-rates?to=MYR" }
        },
        {
          "name": "Invalid currency code",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/exchange-rates?to=US" }
        }
      ]
    }
  ]
}
